# mistral.rs TCP 桥接异构推理配置
# 在所有脚本开头 source 使用

# -----------------------------
# 节点地址
# -----------------------------

# GPU PC（运行 mistralrs 主进程 + CUDA 层）
GPU_PC_IP="192.168.1.10"
GPU_PC_USER="atituiset"

# WSL 本机（运行 mistralrs remote worker，CPU 层）
WSL_IP="127.0.0.1"
WSL_PORT="5051"

# Mate 40 Pro 手机（可选，未实际参与测试）
PHONE_IP="192.168.1.7"
PHONE_PORT="5052"

# -----------------------------
# mistral.rs 源码与构建路径
# -----------------------------

# 源码目录（独立 git repo: https://github.com/Atituiset/mistral.rs）
MISTRALRS_DIR="${HOME}/Projects/gpu-cpu-phone-test/mistral.rs"
MISTRALRS_BIN="${MISTRALRS_DIR}/target/release/mistralrs"

# GPU PC 上的路径
GPU_PC_MISTRALRS_DIR="${HOME}/projects/gpu-cpu-phone-test/mistral.rs"

# -----------------------------
# 模型
# -----------------------------

# 小模型（已验证）
MODEL_QWEN2_05B="${HOME}/models/qwen2-0.5b-instruct-q4_0.gguf"

# 目标模型（均已端到端验证，2026-08-18）
MODEL_QWEN36_35B="${HOME}/models/Qwen_Qwen3.6-35B-A3B-Q3_K_M.gguf"
MODEL_QWEN36_27B="${HOME}/models/Qwen_Qwen3.6-27B-Q3_K_M.gguf"

# 默认使用小模型
DEFAULT_MODEL="${MODEL_QWEN2_05B}"

# -----------------------------
# 默认推理参数
# -----------------------------

DEFAULT_PROMPT="Hello, how are you?"
DEFAULT_MAX_TOKENS="32"
